#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

composer validate --strict
composer audit --locked
php artisan module:validate
php artisan foundation:doctor
vendor/bin/pint --test
vendor/bin/phpstan analyse --no-progress --memory-limit=512M

find modules/genealogy-* modules/liberu-* -type d -name vendor -prune -o -name '*.php' -print0 \
    | xargs -0 -n1 php -l >/dev/null

route_count="$(php artisan route:list --path=api/v1 | awk '/Showing \[/ { gsub(/[^0-9]/, "", $2); print $2 }')"
if [[ -z "$route_count" || "$route_count" -lt 80 ]]; then
    echo "Expected at least 80 capability API routes; found ${route_count:-0}." >&2
    exit 1
fi

php -r '
require "vendor/autoload.php";
$resources = glob("modules/*-filament/src/Resources/*Resource.php") ?: [];
$components = glob("modules/*-livewire/src/*List.php") ?: [];
foreach ($resources as $file) {
    $source = file_get_contents($file);
    preg_match("/^namespace ([^;]+);/m", $source, $namespace);
    preg_match("/^(?:final )?class ([A-Za-z0-9_]+)/m", $source, $class);
    if (! isset($namespace[1], $class[1]) || ! class_exists($namespace[1]."\\".$class[1])) {
        throw new RuntimeException("Unable to load Filament resource: {$file}");
    }
}
foreach ($components as $file) {
    $source = file_get_contents($file);
    preg_match("/^namespace ([^;]+);/m", $source, $namespace);
    preg_match("/^(?:final )?class ([A-Za-z0-9_]+)/m", $source, $class);
    $name = ($namespace[1] ?? "")."\\".($class[1] ?? "");
    $component = "Livewire"."\\Component";
    if (! class_exists($name) || ! is_subclass_of($name, $component)) {
        throw new RuntimeException("Unable to load Livewire component: {$file}");
    }
}
printf("Loaded %d Filament resources and %d Livewire components.\n", count($resources), count($components));
' 

php -r '
require "vendor/autoload.php";
foreach (glob("modules/liberu-*-api/resources/openapi.yaml") ?: [] as $path) {
    $document = \Symfony\Component\Yaml\Yaml::parseFile($path);
    if (($document["openapi"] ?? null) !== "3.1.0" || empty($document["paths"])) {
        throw new RuntimeException("Invalid OpenAPI 3.1 contract: {$path}");
    }
}
echo "Validated OpenAPI contracts.\n";
'

if command -v docker >/dev/null 2>&1; then
    docker compose config --quiet
fi

if command -v kubectl >/dev/null 2>&1 && [[ -f k8s/kustomization.yaml || -f k8s/kustomization.yml || -f k8s/Kustomization ]]; then
    kubectl kustomize k8s >/dev/null
fi

npm run build
XDEBUG_MODE=coverage php artisan test --coverage --min=100
