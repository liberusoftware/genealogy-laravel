{
  "name": "liberusoftware/module-genealogy-collaboration-livewire",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-collaboration-livewire module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/module-genealogy-collaboration": "^1.0",
    "livewire/livewire": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\Collaboration\\Livewire\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Genealogy\\Collaboration\\Livewire\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-collaboration-livewire",
      "provider": "Liberu\\Genealogy\\Collaboration\\Livewire\\CollaborationLivewireServiceProvider"
    }
  }
}
