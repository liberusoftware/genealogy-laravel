{
  "name": "liberusoftware/module-genealogy-reports-filament",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-reports-filament module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/module-genealogy-reports": "^1.0",
    "filament/filament": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\Reports\\Filament\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-reports-filament",
      "provider": "Liberu\\Genealogy\\Reports\\Filament\\ReportsFilamentServiceProvider"
    }
  }
}
