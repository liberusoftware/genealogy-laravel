{
  "name": "genealogy-discovery-filament",
  "display_name": "Genealogy Discovery filament",
  "description": "One-to-one filament adapter for Genealogy Discovery.",
  "version": "1.0.0",
  "category": "presentation",
 "provider": "Liberu\\Genealogy\\Discovery\\Filament\\DiscoveryFilamentServiceProvider",
  "presentation": {"filament": {"admin": ["Liberu\\Genealogy\\Discovery\\Filament\\DiscoveryFilamentPlugin"], "app": ["Liberu\\Genealogy\\Discovery\\Filament\\DiscoveryFilamentPlugin"]}},
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-genealogy-discovery": "^1.0"
    }
  },
  "capabilities": [
    "genealogy.discovery.filament"
  ],
  "features": [
    "filament presentation for discovery"
  ],
  "default_enabled": true
}
