{
  "name": "liberusoftware/module-genealogy-places",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-places module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\Places\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Genealogy\\Places\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-places",
      "provider": "Liberu\\Genealogy\\Places\\PlacesServiceProvider"
    }
  }
}
