{
  "name": "genealogy-media-filament",
  "display_name": "Genealogy Media filament",
  "description": "One-to-one filament adapter for Genealogy Media.",
  "version": "1.0.0",
  "category": "presentation",
 "provider": "Liberu\\Genealogy\\Media\\Filament\\MediaFilamentServiceProvider",
  "presentation": {"filament": {"admin": ["Liberu\\Genealogy\\Media\\Filament\\MediaFilamentPlugin"], "app": ["Liberu\\Genealogy\\Media\\Filament\\MediaFilamentPlugin"]}},
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-genealogy-media": "^1.0"
    }
  },
  "capabilities": [
    "genealogy.media.filament"
  ],
  "features": [
    "filament presentation for media"
  ],
  "default_enabled": true
}
