{
  "name": "liberusoftware/module-genealogy-collaboration-api",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-collaboration-api module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/api-access": "^1.0",
    "liberusoftware/module-genealogy-collaboration": "^1.0",
    "liberusoftware/module-genealogy-core": "^1.0",
    "illuminate/http": "^13.0",
    "illuminate/routing": "^13.0",
    "laravel/sanctum": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\Collaboration\\Api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Genealogy\\Collaboration\\Api\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.0"
  },
  "scripts": {
    "test": "pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-collaboration-api",
      "provider": "Liberu\\Genealogy\\Collaboration\\Api\\CollaborationApiServiceProvider"
    }
  }
}
