{
  "name": "genealogy-discovery",
  "display_name": "Genealogy Discovery",
  "description": "Provider-neutral Genealogy Discovery capability.",
  "version": "1.0.0",
  "category": "capability",
  "provider": "Liberu\\Genealogy\\Discovery\\DiscoveryServiceProvider",
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-genealogy-core": "^1.0",
      "liberusoftware/module-genealogy-people": "^1.0",
      "liberusoftware/module-genealogy-places": "^1.0",
      "liberusoftware/module-genealogy-evidence": "^1.0",
      "liberusoftware/module-genealogy-relationships": "^1.0"
    }
  },
  "capabilities": [
    "genealogy.discovery",
    "genealogy.discovery.search",
    "genealogy.discovery.hints",
    "genealogy.discovery.duplicates",
    "genealogy.discovery.relationship-paths",
    "genealogy.discovery.privacy-indexes",
    "genealogy.discovery.lifecycle"
  ],
  "features": [
    "genealogy discovery",
    "genealogy discovery search",
    "genealogy discovery hints",
    "genealogy discovery duplicates",
    "genealogy discovery relationship-paths",
    "genealogy discovery privacy-indexes",
    "genealogy discovery lifecycle"
  ],
  "default_enabled": true
}
