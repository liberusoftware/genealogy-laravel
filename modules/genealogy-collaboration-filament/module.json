{
  "name": "genealogy-collaboration-filament",
  "display_name": "Genealogy Collaboration filament",
  "description": "One-to-one filament adapter for Genealogy Collaboration.",
  "version": "1.0.0",
  "category": "presentation",
 "provider": "Liberu\\Genealogy\\Collaboration\\Filament\\CollaborationFilamentServiceProvider",
  "presentation": {"filament": {"admin": ["Liberu\\Genealogy\\Collaboration\\Filament\\CollaborationFilamentPlugin"], "app": ["Liberu\\Genealogy\\Collaboration\\Filament\\CollaborationFilamentPlugin"]}},
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-genealogy-collaboration": "^1.0"
    }
  },
  "capabilities": [
    "genealogy.collaboration.filament"
  ],
  "features": [
    "filament presentation for collaboration"
  ],
  "default_enabled": true
}
