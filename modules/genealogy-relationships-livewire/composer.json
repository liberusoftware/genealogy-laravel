{
  "name": "liberusoftware/module-genealogy-relationships-livewire",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-relationships-livewire module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "liberusoftware/module-genealogy-relationships": "^1.0",
    "livewire/livewire": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\Relationships\\Livewire\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-relationships-livewire",
      "provider": "Liberu\\Genealogy\\Relationships\\Livewire\\RelationshipsLivewireServiceProvider"
    }
  }
}
