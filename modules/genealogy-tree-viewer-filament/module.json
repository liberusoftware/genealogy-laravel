{
  "name": "genealogy-tree-viewer-filament",
  "display_name": "Genealogy TreeViewer filament",
  "description": "One-to-one filament adapter for Genealogy TreeViewer.",
  "version": "1.0.0",
  "category": "presentation",
 "provider": "Liberu\\Genealogy\\TreeViewer\\Filament\\TreeViewerFilamentServiceProvider",
  "presentation": {"filament": {"admin": ["Liberu\\Genealogy\\TreeViewer\\Filament\\TreeViewerFilamentPlugin"], "app": ["Liberu\\Genealogy\\TreeViewer\\Filament\\TreeViewerFilamentPlugin"]}},
  "requires": {
    "php": "^8.5",
    "laravel": "^13.0",
    "packages": {
      "liberusoftware/module-genealogy-tree-viewer": "^1.0"
    }
  },
  "capabilities": [
    "genealogy.tree-viewer.filament"
  ],
  "features": [
    "filament presentation for tree-viewer"
  ],
  "default_enabled": true
}
