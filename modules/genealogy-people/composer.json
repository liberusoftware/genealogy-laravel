{
  "name": "liberusoftware/module-genealogy-people",
  "version": "1.0.0",
  "type": "liberu-module",
  "description": "Liberu genealogy-people module.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Genealogy\\People\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "liberu": {
      "name": "genealogy-people",
      "provider": "Liberu\\Genealogy\\People\\PeopleServiceProvider"
    }
  }
}
